{
  "name": "paper-print-photo-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "smoke": "node scripts/smoke-browser.mjs",
    "smoke:real": "node scripts/smoke-browser.mjs --real-photos",
    "smoke:real:gallery": "node scripts/smoke-browser.mjs --real-photo-gallery",
    "smoke:real:preset-gallery": "node scripts/smoke-browser.mjs --real-photo-preset-gallery",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "typescript": "^5.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2"
  }
}
